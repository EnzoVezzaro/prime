  "corpus_tiers": {
    "pr": {
      "description": "Small subset for PR benchmarks — fast enough for every CI run",
      "size_category": "small",
      "max_repos": 5,
      "repositories": ["bat", "httpx", "express", "gin", "spdlog"]
    },
    "nightly": {
      "description": "Full corpus for nightly regression tracking",
      "size_category": ["small", "medium"],
      "max_repos": 15,
      "repositories": ["*"]
    },
    "stress": {
      "description": "Large repositories for stress testing scaling limits",
      "size_category": ["medium", "large"],
      "max_repos": 10,
      "repositories": ["ripgrep", "rich", "fastapi", "fastjson", "redis", "vapor", "ktor"]
    }
  }

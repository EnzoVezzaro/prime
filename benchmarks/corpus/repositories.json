{
  "version": "2.0.0",
  "description": "Prime benchmark corpus with tiered repositories. Repositories are pinned to immutable commits for reproducibility.",
  "language_matrix": {
    "rust": {
      "extensions": ["rs"],
      "repositories": ["bat", "ripgrep", "fd"],
      "size_distribution": {"small": 2, "medium": 1, "large": 0}
    },
    "python": {
      "extensions": ["py"],
      "repositories": ["httpx", "rich", "fastapi"],
      "size_distribution": {"small": 1, "medium": 2, "large": 0}
    },
    "javascript": {
      "extensions": ["js", "jsx"],
      "repositories": ["express"],
      "size_distribution": {"small": 1, "medium": 0, "large": 0}
    },
    "typescript": {
      "extensions": ["ts", "tsx"],
      "repositories": ["zod", "vitest", "esbuild"],
      "size_distribution": {"small": 1, "medium": 1, "large": 0}
    },
    "go": {
      "extensions": ["go"],
      "repositories": ["gin", "echo"],
      "size_distribution": {"small": 2, "medium": 0, "large": 0}
    },
    "java": {
      "extensions": ["java"],
      "repositories": ["fastjson"],
      "size_distribution": {"small": 0, "medium": 1, "large": 0}
    },
    "cpp": {
      "extensions": ["cpp", "hpp", "h", "c"],
      "repositories": ["spdlog"],
      "size_distribution": {"small": 1, "medium": 0, "large": 0}
    },
    "c": {
      "extensions": ["c", "h"],
      "repositories": ["redis"],
      "size_distribution": {"small": 0, "medium": 1, "large": 0}
    },
    "typescript": {
      "extensions": ["ts"],
      "repositories": ["zod", "vitest", "esbuild"],
      "size_distribution": {"small": 1, "medium": 1, "large": 0}
    }
  },

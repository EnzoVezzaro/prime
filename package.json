{
  "name": "prime",
  "version": "0.1.0",
  "description": "Prime - Ultra-light, ultra-fast codebase knowledge graph for agents",
  "private": true,
  "scripts": {
    "dev": "cargo run --bin prime --",
    "build": "cargo build --release --workspace",
    "build:debug": "cargo build --workspace",
    "test": "cargo test --workspace",
    "test:bench": "cargo bench --workspace",
    "check": "cargo check --workspace",
    "fmt": "cargo fmt --all",
    "lint": "cargo clippy --workspace -- -D warnings",
    "docs": "cargo doc --workspace --no-deps --open",
    "clean": "cargo clean",
    "update": "cargo update --workspace",
    "install": "cargo install --path prime-cli --root ./dist",
    "dist": "cargo build --release --workspace && cargo install --path prime-cli --root ./dist",
    "package": "cargo package --allow-dirty --workspace",
    "publish:dry": "cargo publish --dry-run --workspace",
    "publish": "cargo publish --workspace",
    "fmt:check": "cargo fmt --all --check",
    "prime": "cargo run --bin prime --",
    "prime:build": "cargo run --bin prime -- build",
    "prime:build:force": "cargo run --bin prime -- build --force",
    "prime:build:progress": "cargo run --bin prime -- build --progress",
    "prime:query": "cargo run --bin prime -- query",
    "prime:query:json": "cargo run --bin prime -- query --format json",
    "prime:query:minimal": "cargo run --bin prime -- query --format minimal",
    "prime:query:search": "cargo run --bin prime -- query --type search",
    "prime:query:name": "cargo run --bin prime -- query --type name",
    "prime:query:prefix": "cargo run --bin prime -- query --type prefix",
    "prime:query:context": "cargo run --bin prime -- query --type context",
    "prime:stats": "cargo run --bin prime -- stats",
    "prime:check": "cargo run --bin prime -- check",
    "prime:deps": "cargo run --bin prime -- deps",
    "prime:deps:transitive": "cargo run --bin prime -- deps --transitive",
    "prime:dependents": "cargo run --bin prime -- dependents",
    "prime:dependents:transitive": "cargo run --bin prime -- dependents --transitive",
    "prime:calls": "cargo run --bin prime -- calls",
    "prime:calls:callers": "cargo run --bin prime -- calls --direction callers",
    "prime:calls:callees": "cargo run --bin prime -- calls --direction callees",
    "prime:calls:both": "cargo run --bin prime -- calls --direction both",
    "prime:export": "cargo run --bin prime -- export",
    "prime:export:json": "cargo run --bin prime -- export --format json",
    "prime:export:msgpack": "cargo run --bin prime -- export --format msgpack",
    "prime:export:dot": "cargo run --bin prime -- export --format dot",
    "prime:stats": "cargo run --bin prime -- stats",
    "prime:check": "cargo run --bin prime -- check",
    "prime:init": "cargo run --bin prime -- init",
    "prime:init:force": "cargo run --bin prime -- init --force",
    "dist:all": "npm run build && npm run dist",
    "release": "npm run build && npm run package && npm run publish:dry",
    "prepare": "husky install",
    "start:stack": "docker-compose up -d",
    "start:stack:detached": "docker-compose up -d --remove-orphans",
    "start:stack:with-relay": "docker-compose -f docker-compose.yml -f docker-compose.relay.yml up -d",
    "start:stack:no-relay": "docker-compose -f docker-compose.yml up -d",
    "stop:stack": "docker-compose down",
    "logs:stack": "docker-compose logs -f",
    "ps:stack": "docker-compose ps"
  },
  "keywords": [
    "prime",
    "codebase",
    "knowledge-graph",
    "agent",
    "ai",
    "code-intelligence",
    "static-analysis",
    "research"
  ],
  "author": "Prime Research Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnzoVezzaro/prime.git"
  },
  "bugs": {
    "url": "https://github.com/EnzoVezzaro/prime/issues"
  },
  "homepage": "https://github.com/EnzoVezzaro/prime#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "prettier": "^3.2.0"
  }
}